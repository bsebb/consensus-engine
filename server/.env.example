# BACKEND ENVIRONMENT VARIABLES
# Copy this file, rename it to .env, and paste the real keys provided in Discord.

# The port your Express server runs on
PORT=3000

# The connection string for Prisma to talk to PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/consensus_db"

# Google Places API Key (Keep this secret!)
GOOGLE_PLACES_API_KEY="your_google_api_key_here"

# The URL of your React frontend (Needed to bypass CORS errors)
CLIENT_URL="http://localhost:5173"

# Stable random secret shared by every backend instance (at least 32 random bytes).
# Generate locally with: openssl rand -hex 32
HOST_TOKEN_SECRET="replace-with-a-long-random-secret"

# Required to enable system telemetry and prune endpoints in production.
# ADMIN_API_KEY="another-long-random-secret"

# Set only to the actual reverse proxy ranges used by your deployment.
# Direct local installs should leave this unset.
# TRUST_PROXY="loopback"

# Dedicated LISTEN connection for cross-server broadcasts. It must point to the
# same database/branch as DATABASE_URL. With Neon, the unpooled hostname is derived
# automatically when omitted; an explicit direct connection is also supported.
# SOCKET_DATABASE_URL="postgresql://user:password@direct-host/consensus_db"

# Default websocket-only transport needs no sticky HTTP sessions.
# Enable polling only with a load balancer that provides sticky sessions.
# SOCKET_POLLING=false

# Keep the same rate-limit namespace across all replicas (default: consensus).
# RATE_LIMIT_NAMESPACE=consensus
