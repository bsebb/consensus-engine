datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoomStatus {
  CONFIGURING
  SUGGESTING
  VOTING
  RESOLVED
}

enum OptionSource {
  GOOGLE_API
  USER_CUSTOM
}

model Room {
  id             String     @id @default(uuid())
  pin            String     @unique
  hostId         String
  hostDeviceId   String?
  status         RoomStatus @default(CONFIGURING)
  
  theme          String?
  radius         Int?
  
  runtimeState   Json?
  winnerOptionId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  winnerOption   Option?       @relation("RoomWinner", fields: [winnerOptionId], references: [id])
  participants   Participant[]
  options        Option[]      @relation("RoomOptions")

  @@index([hostDeviceId])
  @@index([createdAt])
  @@map("rooms")
}

model Participant {
  id        String   @id @default(uuid())
  roomId    String
  deviceId  String?
  budgetCap Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room      Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  votes     Vote[]
  feedbacks Feedback[]

  @@index([roomId])
  @@index([deviceId])
  @@index([roomId, deviceId])
  @@index([createdAt])
  @@map("participants")
}

model Option {
  id            String       @id @default(uuid())
  roomId        String
  name          String
  source        OptionSource
  googlePlaceId String?
  priceLevel    Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  room          Room         @relation("RoomOptions", fields: [roomId], references: [id], onDelete: Cascade)
  roomsWon      Room[]       @relation("RoomWinner")
  votes         Vote[]
  feedbacks     Feedback[]

  @@index([roomId])
  @@index([googlePlaceId])
  @@map("options")
}

model Vote {
  id            String   @id @default(uuid())
  participantId String
  optionId      String
  score         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  option        Option      @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId])
  @@unique([participantId, optionId])
  @@map("votes")
}

model VenueAnalytics {
  id               String @id @default(uuid())
  googlePlaceId    String @unique
  name             String
  truePriceAvg     Float  @default(0.0)
  consensusWinRate Float  @default(0.0)
  satisfactionAvg  Float  @default(0.0)
  totalReviews     Int    @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("venue_analytics")
}

model Feedback {
  id                 String @id @default(uuid())
  participantId      String
  optionId           String
  satisfactionScore  Int
  priceAccuracyScore Int
  comment            String?

  participant        Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  option             Option      @relation(fields: [optionId], references: [id], onDelete: Cascade)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([participantId])
  @@index([optionId])
  @@index([createdAt])
  @@map("feedbacks")
}

model CachedVenue {
  id         String   @id @default(uuid())
  gridKey    String
  placeKey   String   @unique
  name       String
  category   String
  address    String?
  locality   String?
  lat        Float
  lng        Float
  priceLevel Int      @default(2)
  rating     Float    @default(4.5)
  reviews    Int      @default(120)
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([gridKey])
  @@map("cached_venues")
}

model ApiRateLimit {
  key       String   @id
  count     Int
  resetAt   DateTime @db.Timestamptz(6)
  @@index([resetAt])
  @@map("api_rate_limits")
}

model SocketAttachment {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  payload   Bytes
  @@index([createdAt])
  @@map("socket_io_attachments")
}

model DashboardOwner {
  id       String  @id
  enrolled Boolean @default(false)
  setupTokenHash String?
  @@map("dashboard_owner")
}

model DashboardCredential {
  id         String   @id
  publicKey  Bytes
  counter    BigInt   @default(0)
  transports Json     @default("[]")
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  @@map("dashboard_credentials")
}

model DashboardChallenge {
  id        String   @id
  challenge String
  purpose   String
  binding   String
  expiresAt DateTime @db.Timestamptz(6)
  @@index([expiresAt])
  @@map("dashboard_challenges")
}

model DashboardSession {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([expiresAt])
  @@map("dashboard_sessions")
}
