# FRONTEND ENVIRONMENT VARIABLES
# Copy this file, rename it to .env, and replace the values if needed.

# The URL of your local Node.js backend.
# When deploying to production, this will change to your real server URL.
VITE_API_URL="http://localhost:3000/api/v1"
VITE_SOCKET_URL="http://localhost:3000"

# Preferred shared origin for both REST and sockets (leave unset to use the Vite proxy)
# VITE_SERVER_URL="https://your-api.example.com"

# Set true only when the backend also enables polling and the proxy is sticky.
# VITE_SOCKET_POLLING=false
